{
  "name": "jardin-de-pendientes",
  "private": true,
  "description": "Checklist gamificado: PWA + Supabase. Este package.json es solo para correr las pruebas.",
  "scripts": {
    "test": "TZ=America/Argentina/Buenos_Aires node --experimental-strip-types --no-warnings --test 'tests/unit/*.test.*'",
    "test:e2e": "TZ=America/Argentina/Buenos_Aires node --test --test-concurrency=1 'tests/e2e/*.test.*'",
    "test:all": "npm test && npm run test:e2e"
  },
  "devDependencies": {
    "http_ece": "1.2.0",
    "playwright": "1.56.1"
  }
}
